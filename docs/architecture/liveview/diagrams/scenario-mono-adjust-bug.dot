digraph {
  graph [rankdir=TB, labelloc="t", label="BUG — sample switch / open Adjust: mono ihs29 vs Adjust ihs27", fontsize=16, nodesep=0.45, ranksep=0.55, splines=true, overlap=false];
  node [shape=box, style="rounded,filled", fillcolor="#f7f7f7", fontname="Helvetica", fontsize=11];
  edge [fontname="Helvetica", fontsize=9];

  subgraph cluster_mono_ok {
    label="mono path OK (follows SampleStore.current)"; style="rounded,dashed"; color="#bbbbbb"; fontsize=10;
    "sample_store" [label="SampleStore.current\n→ ihs29"];
    "present_right" [label="present_right\n→ sample-presentation"];
    "mono_presenter" [label="Mono presenter\nprofile / .out / quality = ihs29", fillcolor="#e8f5e9"];
    "ui_right" [label="Mono right pane\nI(q) = ihs29 disk GNOM", fillcolor="#e8f5e9"];
  }

  subgraph cluster_adjust_stale {
    label="Adjust stuck / clobbered"; style="rounded,dashed"; color="#bbbbbb"; fontsize=10;
    "mono_coordinator" [label="Mono coordinator\n→ gnom-adjust-bind"];
    "gnom_adjust" [label="GNOM Adjust (open)\nstill ihs27 identity\n+ auto _run_preview", fillcolor="#ffebee", color="#d62728", penwidth=2.5, style="rounded,filled,bold"];
    "session" [label="LiveviewSession\nmonodisperse_wizard_params\n(from prior ihs27 refine)", fillcolor="#fff3e0"];
  }


  "sample_store" -> "present_right" [color="#2ca02c", fontcolor="#2ca02c", style="solid", penwidth=1.2, xlabel="current → ihs29"];
  "present_right" -> "mono_presenter" [color="#1f77b4", fontcolor="#1f77b4", style="solid", penwidth=1.2, xlabel="DISK|LIVE bundle"];
  "mono_presenter" -> "ui_right" [color="#1f77b4", fontcolor="#1f77b4", style="solid", penwidth=1.2, xlabel="plots + passport ihs29"];
  "mono_presenter" -> "mono_coordinator" [color="#2ca02c", fontcolor="#2ca02c", style="solid", penwidth=1.2, xlabel="apply_bundle / load_from_disk"];
  "mono_coordinator" -> "gnom_adjust" [color="#d62728", fontcolor="#d62728", style="dashed", penwidth=2.8, xlabel="MISSING _push_gnom_adjust_context"];
  "session" -> "gnom_adjust" [color="#d62728", fontcolor="#d62728", style="dashed", penwidth=2.8, xlabel="wizard_params → set_context → auto _run_preview clobber"];

  subgraph cluster_legend {
    label="edge kinds"; fontsize=10; style="dashed"; color="#aaaaaa";
    node [shape=plaintext, fillcolor="white", style=""];
    legend [label=<<table border="0" cellborder="0" cellspacing="2"><tr><td><font color="#1f77b4">━━</font></td><td align="left"><font color="#1f77b4">data</font></td></tr><tr><td><font color="#d62728">━━</font></td><td align="left"><font color="#d62728">signal/control</font></td></tr><tr><td><font color="#2ca02c">━━</font></td><td align="left"><font color="#2ca02c">state</font></td></tr><tr><td><font color="#ff7f0e">━━</font></td><td align="left"><font color="#ff7f0e">exec</font></td></tr><tr><td><font color="#7f7f7f">━━</font></td><td align="left"><font color="#7f7f7f">ui</font></td></tr><tr><td><font color="#d62728">- -</font></td><td align="left"><font color="#d62728">broken (dashed)</font></td></tr><tr><td><font color="#2ca02c">━━</font></td><td align="left"><font color="#2ca02c">fixed (thick)</font></td></tr></table>>];
  }
}
