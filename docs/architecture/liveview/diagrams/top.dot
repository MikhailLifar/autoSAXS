digraph {
  graph [rankdir=TB, labelloc="t", label="LiveView top-level (black boxes)", fontsize=16, nodesep=0.45, ranksep=0.55, splines=true, overlap=false];
  node [shape=box, style="rounded,filled", fillcolor="#f7f7f7", fontname="Helvetica", fontsize=11];
  edge [fontname="Helvetica", fontsize=9];

  subgraph cluster_ingest {
    label="ingest"; style="rounded,dashed"; color="#bbbbbb"; fontsize=10;
    "watchdir" [label="Watchdir + .guisaxs_liveview/"];
    "ingest_backends" [label="Ingest backends"];
    "settler" [label="RevisionSettler"];
    "ingress" [label="RevisionIngress"];
  }

  subgraph cluster_facts {
    label="session + sample identity"; style="rounded,dashed"; color="#bbbbbb"; fontsize=10;
    "session" [label="LiveviewSession"];
    "sample_store" [label="SampleStore\n→ sample-presentation"];
    "planner" [label="plan_for"];
  }

  subgraph cluster_run {
    label="execute"; style="rounded,dashed"; color="#bbbbbb"; fontsize=10;
    "executor" [label="LiveviewJobExecutor"];
    "skill_runner" [label="SkillRunner"];
  }

  subgraph cluster_present {
    label="present"; style="rounded,dashed"; color="#bbbbbb"; fontsize=10;
    "middle_sync" [label="sync_middle_view"];
    "present_right" [label="present_right\n→ sample-presentation"];
    "modeling" [label="ModelingChildManager"];
  }

  subgraph cluster_ui {
    label="UI"; style="rounded,dashed"; color="#bbbbbb"; fontsize=10;
    "controller" [label="LiveviewController"];
    "ui_left" [label="Left panel"];
    "ui_middle" [label="Middle panel"];
    "ui_right" [label="Right panel (mono/poly)\n→ gnom-adjust-bind"];
  }


  "watchdir" -> "ingest_backends" [color="#1f77b4", fontcolor="#1f77b4", xlabel="frames / .dat"];
  "ingest_backends" -> "settler" [color="#d62728", fontcolor="#d62728", xlabel="observe"];
  "settler" -> "ingress" [color="#d62728", fontcolor="#d62728", xlabel="stable SampleRevision"];
  "ingress" -> "sample_store" [color="#2ca02c", fontcolor="#2ca02c", xlabel="board / select"];
  "ingress" -> "executor" [color="#ff7f0e", fontcolor="#ff7f0e", xlabel="admit job"];
  "sample_store" -> "planner" [color="#2ca02c", fontcolor="#2ca02c", xlabel="current Sample"];
  "session" -> "planner" [color="#2ca02c", fontcolor="#2ca02c", xlabel="facts / arming"];
  "planner" -> "executor" [color="#ff7f0e", fontcolor="#ff7f0e", xlabel="PipelinePlan"];
  "executor" -> "skill_runner" [color="#ff7f0e", fontcolor="#ff7f0e", xlabel="JobStep"];
  "skill_runner" -> "present_right" [color="#1f77b4", fontcolor="#1f77b4", xlabel="skill result LIVE"];
  "sample_store" -> "middle_sync" [color="#2ca02c", fontcolor="#2ca02c", xlabel="current stem"];
  "session" -> "middle_sync" [color="#2ca02c", fontcolor="#2ca02c", xlabel="intake / buffer"];
  "sample_store" -> "present_right" [color="#2ca02c", fontcolor="#2ca02c", xlabel="current stem"];
  "present_right" -> "ui_right" [color="#1f77b4", fontcolor="#1f77b4", xlabel="artifact bundle"];
  "middle_sync" -> "ui_middle" [color="#1f77b4", fontcolor="#1f77b4", xlabel="layout + paint"];
  "controller" -> "session" [color="#d62728", fontcolor="#d62728", xlabel="Session API"];
  "controller" -> "middle_sync" [color="#d62728", fontcolor="#d62728", xlabel="history sync"];
  "controller" -> "present_right" [color="#d62728", fontcolor="#d62728", xlabel="DISK|LIVE present"];
  "ui_left" -> "controller" [color="#7f7f7f", fontcolor="#7f7f7f", xlabel="calib / buffer / mask"];
  "ui_right" -> "controller" [color="#7f7f7f", fontcolor="#7f7f7f", xlabel="arm / Adjust / Process"];
  "session" -> "ui_left" [color="#2ca02c", fontcolor="#2ca02c", xlabel="session-tied chrome"];
  "present_right" -> "modeling" [color="#2ca02c", fontcolor="#2ca02c", xlabel="sample ModelingContext"];
  "watchdir" -> "session" [color="#1f77b4", fontcolor="#1f77b4", xlabel="session.yaml"];
  "watchdir" -> "sample_store" [color="#1f77b4", fontcolor="#1f77b4", xlabel="history.yaml"];

  subgraph cluster_legend {
    label="edge kinds"; fontsize=10; style="dashed"; color="#aaaaaa";
    node [shape=plaintext, fillcolor="white", style=""];
    legend [label=<<table border="0" cellborder="0" cellspacing="2"><tr><td><font color="#1f77b4">━━</font></td><td align="left"><font color="#1f77b4">data</font></td></tr><tr><td><font color="#d62728">━━</font></td><td align="left"><font color="#d62728">signal/control</font></td></tr><tr><td><font color="#2ca02c">━━</font></td><td align="left"><font color="#2ca02c">state</font></td></tr><tr><td><font color="#ff7f0e">━━</font></td><td align="left"><font color="#ff7f0e">exec</font></td></tr><tr><td><font color="#7f7f7f">━━</font></td><td align="left"><font color="#7f7f7f">ui</font></td></tr></table>>];
  }
}
