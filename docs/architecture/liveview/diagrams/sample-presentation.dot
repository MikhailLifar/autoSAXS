digraph {
  graph [rankdir=TB, labelloc="t", label="Sample-tied right presentation", fontsize=16, nodesep=0.45, ranksep=0.55, splines=true, overlap=false];
  node [shape=box, style="rounded,filled", fillcolor="#f7f7f7", fontname="Helvetica", fontsize=11];
  edge [fontname="Helvetica", fontsize=9];

  "sample_store" [label="SampleStore"];
  "session" [label="LiveviewSession"];
  "present_right" [label="present_right"];
  "mono_presenter" [label="Mono artifact presenter\n→ gnom-adjust-bind"];
  "ui_right" [label="Right panel (mono/poly)\n→ gnom-adjust-bind"];
  "mono_coordinator" [label="Mono coordinator\n→ gnom-adjust-bind"];

  "sample_store" -> "present_right" [color="#2ca02c", fontcolor="#2ca02c", xlabel="current stem only"];
  "session" -> "present_right" [color="#2ca02c", fontcolor="#2ca02c", xlabel="shape mode prefs (not identity)"];
  "present_right" -> "mono_presenter" [color="#1f77b4", fontcolor="#1f77b4", xlabel="discover_* / LIVE ingest"];
  "mono_presenter" -> "ui_right" [color="#1f77b4", fontcolor="#1f77b4", xlabel="plots + passport"];
  "mono_presenter" -> "mono_coordinator" [color="#2ca02c", fontcolor="#2ca02c", xlabel="profile / .out / quality"];
  "mono_coordinator" -> "mono_presenter" [color="#d62728", fontcolor="#d62728", xlabel="apply_bundle / load_from_disk"];

  subgraph cluster_legend {
    label="edge kinds"; fontsize=10; style="dashed"; color="#aaaaaa";
    node [shape=plaintext, fillcolor="white", style=""];
    legend [label=<<table border="0" cellborder="0" cellspacing="2"><tr><td><font color="#1f77b4">━━</font></td><td align="left"><font color="#1f77b4">data</font></td></tr><tr><td><font color="#d62728">━━</font></td><td align="left"><font color="#d62728">signal/control</font></td></tr><tr><td><font color="#2ca02c">━━</font></td><td align="left"><font color="#2ca02c">state</font></td></tr><tr><td><font color="#ff7f0e">━━</font></td><td align="left"><font color="#ff7f0e">exec</font></td></tr><tr><td><font color="#7f7f7f">━━</font></td><td align="left"><font color="#7f7f7f">ui</font></td></tr></table>>];
  }
}
