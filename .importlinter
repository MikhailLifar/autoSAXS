[importlinter]
root_package = autosaxs

[importlinter:contract:core_independent]
name = Core does not depend on higher layers
type = forbidden
source_modules =
    autosaxs.core
forbidden_modules =
    autosaxs.skill
    autosaxs.cli

[importlinter:contract:skill_independent]
name = Skill does not depend on cli
type = forbidden
source_modules =
    autosaxs.skill
forbidden_modules =
    autosaxs.cli

[importlinter:contract:foreign_leaf]
name = Foreign code does not import autosaxs
type = forbidden
source_modules =
    autosaxs.foreign
forbidden_modules =
    autosaxs.core
    autosaxs.skill
    autosaxs.cli
