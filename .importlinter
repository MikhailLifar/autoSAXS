[importlinter]
root_packages =
    autosaxs
    guisaxs_skills
include_external_packages = True
exclude_type_checking_imports = True

[importlinter:contract:core_independent]
name = Core does not depend on higher layers
type = forbidden
source_modules =
    autosaxs.core
forbidden_modules =
    autosaxs.skill
    autosaxs.pipeline
    autosaxs.cli

[importlinter:contract:skill_independent]
name = Skill does not depend on pipeline or cli
type = forbidden
source_modules =
    autosaxs.skill
forbidden_modules =
    autosaxs.pipeline
    autosaxs.cli

[importlinter:contract:pipeline_cli_peers]
name = Pipeline and CLI are peers (no cross-import)
type = forbidden
source_modules =
    autosaxs.pipeline
forbidden_modules =
    autosaxs.cli

[importlinter:contract:cli_pipeline_peers]
name = CLI and Pipeline are peers (no cross-import)
type = forbidden
source_modules =
    autosaxs.cli
forbidden_modules =
    autosaxs.pipeline

[importlinter:contract:foreign_leaf]
name = Foreign code does not import autosaxs
type = forbidden
source_modules =
    autosaxs.foreign
forbidden_modules =
    autosaxs.core
    autosaxs.skill
    autosaxs.pipeline
    autosaxs.cli

[importlinter:contract:liveview_panels_no_skill]
name = Liveview UI panels do not import autosaxs.skill
type = forbidden
source_modules =
    guisaxs_skills.liveview.ui.panels
forbidden_modules =
    autosaxs.skill
# Presentation helpers go through liveview.services.skill_present (indirect OK).
allow_indirect_imports = True

[importlinter:contract:liveview_session_no_widgets]
name = Liveview session does not import Qt widgets or UI panels
type = forbidden
source_modules =
    guisaxs_skills.liveview.session
forbidden_modules =
    guisaxs_skills.liveview.ui.panels
    guisaxs_skills.liveview.ui.widgets
    guisaxs_skills.ui
# QtWidgets cannot be named as a forbidden external subpackage in importlinter;
# project widget/panel packages cover the session↛widgets/panels edge.
allow_indirect_imports = True

[importlinter:contract:liveview_pipeline_no_panels]
name = Liveview pipeline does not import UI panels
type = forbidden
source_modules =
    guisaxs_skills.liveview.pipeline
forbidden_modules =
    guisaxs_skills.liveview.ui.panels
allow_indirect_imports = True
